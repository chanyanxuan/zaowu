# 造物工坊 环境变量示例 —— 复制为 .env 并填入真实值
# 大模型 API Key(必须)
DEEPSEEK_API_KEY=sk-xxxxxxxx
MOONSHOT_API_KEY=sk-xxxxxxxx

# 登录与计费
REQUIRE_AUTH=1
PUBLIC_BASE=https://yourdomain.com
VIEWER_BASE=https://yourdomain.com/viewer

# 短信(腾讯云,需企业/个体户资质;SMS_PROVIDER 可选 mock|tencent|webhook)
SMS_PROVIDER=mock
SMS_SIGN=造物工坊
SMS_TEMPLATE_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_SMS_SDK_APP_ID=

# 支付(PAY_GATEWAY 可选 mock|alipay|epay)
PAY_GATEWAY=mock
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
EPAY_API_URL=
EPAY_PID=
EPAY_KEY=
